# --- Public (client + server) — Base MAINNET ---
NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_EXPLORER=https://basescan.org
NEXT_PUBLIC_CONTRACT=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Deploy block (event log taraması bu blok'tan itibaren olur)
NEXT_PUBLIC_DEPLOY_BLOCK=0

# Mainnet'te DEMO false olmalı!
NEXT_PUBLIC_DEMO=false

# ERC-8021 Builder Code — base.dev → Settings → Builder Code
# Mainnet'te kesin set edilmeli (Talent Builder Score için kritik)
NEXT_PUBLIC_BUILDER_CODE=

# --- Server only (Vercel env'ye koy, client bundle'a sızmaz) ---

# Görsel storage: VPS disk
STORAGE=local
LOCAL_UPLOAD_DIR=/opt/baseworld/uploads
PUBLIC_BASE_URL=https://frostbite.pro/baseworld

# Pinata fallback (STORAGE=pinata istersen):
PINATA_JWT=

# Önerilen: pinned RPC key (Alchemy/Infura) — public RPC limit'lerine takılma
# event log taraması ve yüksek trafik için public.base.org yetersiz olabilir
SERVER_RPC_URL=

# Pre-pin moderation (üretim için önerilen)
MODERATION_PROVIDER=openai
OPENAI_API_KEY=
