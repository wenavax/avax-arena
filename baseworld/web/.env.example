# --- Public (client + server) ---
# Bu dosya Base SEPOLIA test ağı içindir. Mainnet için .env.mainnet.example'a bak.
# Sepolia (84532) USDC faucet'ı: https://faucet.circle.com (Base Sepolia seç)
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_EXPLORER=https://sepolia.basescan.org
NEXT_PUBLIC_CONTRACT=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Deploy block (event log taraması bu blok'tan itibaren olur)
NEXT_PUBLIC_DEPLOY_BLOCK=0

# Demo modu: true → tx göndermez, simüle eder; false → canlı zincir
NEXT_PUBLIC_DEMO=true

# ERC-8021 Builder Code — base.dev → Settings → Builder Code
# Aktif olunca tüm tx calldata'sına attribution suffix eklenir → Base
# ekosistem ödülleri (Talent Builder Score) için gerekli. Boş = devre dışı.
NEXT_PUBLIC_BUILDER_CODE=

# --- Server only (Vercel env'ye koy, client bundle'a sızmaz) ---

# Görsel depolama backend'i:
#   "local"  → VPS disk'ine yaz, public URL döner (ÖNERİLEN — Pinata limit yok)
#   "pinata" → IPFS Pinata, ipfs:// URI döner
STORAGE=local

# Local backend ayarları (STORAGE=local için):
LOCAL_UPLOAD_DIR=./public/uploads
# Görselin döneceği base URL. Production'da gerçek domain.
PUBLIC_BASE_URL=http://localhost:3000

# Pinata backend (STORAGE=pinata için):
PINATA_JWT=

# Opsiyonel: pinned RPC key (örn. Alchemy) — public RPC limit'lerine takılma
SERVER_RPC_URL=

# Opsiyonel: pre-pin moderation
# Şu an "openai" destekleniyor (omni-moderation-latest). Boş bırakırsan
# moderation skip + manuel blocklist akışı.
MODERATION_PROVIDER=
OPENAI_API_KEY=
