# Sweep çağrısı atacak cüzdanın PK'sı.
# Bu cüzdan SADECE gas öder; USDC akışı kontratın destination'ına gider, bu PK
# ile USDC'yi yönlendiremezsin (destination immutable).
# Yine de güvenli sakla — kompromize olursa attacker gas tüketebilir.
SWEEPER_PK=

# Base RPC. Public yeterli ama Alchemy/Infura önerilir (rate limit yok).
RPC_URL=https://sepolia.base.org

# AtlasTreasury kontrat adresi (Sepolia v2: 0x6c6d05c168aca2bb34cd0c9e71f27d50662fb988)
VAULT_ADDRESS=0x6c6d05c168aca2bb34cd0c9e71f27d50662fb988

# Polling
LOOP=1
POLL_SECONDS=60

# DRY_RUN=1 → tx atmaz, sadece kontrol log'lar
DRY_RUN=
